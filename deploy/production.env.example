# Copy to a private .env file and replace every placeholder. Do not commit real credentials.
IMAGE_REF=ccr.ccs.tencentyun.com/pigpig/cms-backend-v2@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_USER=cms
POSTGRES_DB=cms
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
CMS_TRUSTED_ORIGIN_URL=https://www.example.com
BACKEND_ORIGIN=https://api.example.com
BACKEND_HOST_PORT=8082
CMS_ADMIN_NAME=admin
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
CMS_SMTP_HOST=smtp.qiye.aliyun.com
CMS_SMTP_PORT=465
CMS_SMTP_TLS_MODE=tls
CMS_SMTP_USERNAME=sender@example.com
CMS_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
CMS_SMTP_FROM=CMS <sender@example.com>
CMS_SMTP_MAX_CONCURRENCY=3
CMS_SMTP_CONNECT_TIMEOUT=10s
CMS_SMTP_SEND_TIMEOUT=20s
# CMS_DATABASE_URL is generated by deploy/render-env from PostgreSQL credentials.
